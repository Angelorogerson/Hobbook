VITE_API_URL=http://localhost:5000/api

# Optional: external donation page. The "Hobbook unterstützen" link is hidden when unset.
# VITE_SUPPORT_URL=https://ko-fi.com/your-name

# Imprint (§ 5 DDG). Required before a public launch. Set them in the hosting
# provider's build settings so your address is not committed to the repository.
# Separate address lines with a semicolon.
# VITE_OPERATOR_NAME=Vorname Nachname
# VITE_OPERATOR_ADDRESS=Straße 1;12345 Stadt
# VITE_OPERATOR_EMAIL=kontakt@example.org
