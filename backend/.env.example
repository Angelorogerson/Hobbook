# Server
PORT=5000
NODE_ENV=development

# MongoDB (Lokale Installation - Community Server)
# Ersetze die Verbindung mit deinen MongoDB-Einstellungen
MONGODB_URI=mongodb://localhost:27017/hobbook

# Für MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Hobbook

# JWT Secret (lokal ersetzen; für Production einen sicheren Zufallswert verwenden)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# CORS - Frontend URL (für Development)
CLIENT_URL=http://localhost:8081

# Optionale Settings:
# NODE_ENV=production (für Production-Setup)
