# Server
PORT=5000
NODE_ENV=development
# Set when running behind a reverse proxy (e.g. 1) so rate limits see real client IPs
# TRUST_PROXY=1

# MongoDB (local or Atlas). Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/hobbook

# JWT: use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# The server refuses to start in production with a missing or weak secret.
JWT_SECRET=<replace-with-a-long-random-secret>
JWT_EXPIRES_IN=7d

# Allowed frontend origins (comma-separated)
CLIENT_URL=http://localhost:5173

# Optional: geocoding provider compatible with the Nominatim API
# GEOCODER_URL=https://nominatim.openstreetmap.org

# ── Stammspiel loop: jobs, email, push ──────────────────────────────────────
# Secret for POST /api/jobs/run (external cron + .github/workflows/jobs.yml). Long random value.
# JOB_SECRET=<replace-with-a-long-random-secret>
# The API also runs the jobs itself every N minutes while awake (0 = off).
# JOBS_INTERVAL_MIN=5

# Public address of the web app, used for links in emails and push (no trailing slash).
# PUBLIC_APP_URL=https://hobbook.example.org

# Email: brevo (free tier) | console (log only, default in development) | off
# MAIL_DRIVER=brevo
# BREVO_API_KEY=<from Brevo: SMTP & API, API keys>
# MAIL_FROM=hallo@example.org
# MAIL_FROM_NAME=Hobbook

# Optional: separate secret for one-tap email links (defaults to JWT_SECRET; changing it voids old links).
# LINK_SECRET=<replace-with-a-long-random-secret>

# Optional web push: generate once with npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hallo@example.org
