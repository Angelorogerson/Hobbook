// Cloudflare Workers static assets: serves the built frontend.
// Build command in Cloudflare: cd frontend && npm ci && npm run build
// Deploy command: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hobbook",
  "compatibility_date": "2026-11-17",
  // Adds link previews (Open Graph) for shared Stammspiel and event links; see worker/index.js.
  "main": "worker/index.js",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    // Unknown paths such as /events/123 return index.html so the React router can handle them.
    "not_found_handling": "single-page-application",
    // Only these paths go through the worker; everything else is served directly.
    "run_worker_first": ["/s/*", "/stammspiel/*", "/events/*"]
  },
  "vars": {
    // Public API base used for previews. Set to your Render URL, e.g. https://hobbook-api.onrender.com/api
    "API_URL": ""
  }
}
